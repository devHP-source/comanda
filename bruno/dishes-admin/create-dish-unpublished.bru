meta {
  name: Create dish - unpublished TEST3 with allergens (201)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/dishes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "code": "TEST3",
    "name": { "it": "Piatto per il form" },
    "price": 6.5,
    "category": "{{seededCategoryId}}",
    "allergens": ["gluten", "eggs"],
    "isPublished": false
  }
}

assert {
  res.status: eq 201
  res.body.code: eq TEST3
  res.body.isPublished: eq false
}

script:post-response {
  // Unpublished on purpose: the public GET /api/dishes/:id answers 404, the admin one must answer 200
  if (res.status === 201) {
    bru.setVar("adminDishId", res.body._id)
  }
}

tests {
  test("starts with two allergens, cleared later in the folder", () => {
    expect(res.body.allergens).to.eql(["gluten", "eggs"])
  })
}
