meta {
  name: Update status - kitchen ready again (200)
  type: http
  seq: 25
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{kitchenToken}}
}

body:json {
  {
    "status": "ready"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq ready
}
