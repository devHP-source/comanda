meta {
  name: Create order - no items (400)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "tableNumber": 50,
    "items": []
  }
}

assert {
  res.status: eq 400
  res.body.code: eq EMPTY_ORDER
}
