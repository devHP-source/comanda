meta {
  name: Get orders - unknown status (400)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/orders?status=sent,cooking
  body: none
  auth: bearer
}

params:query {
  status: sent,cooking
}

auth:bearer {
  token: {{kitchenToken}}
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_STATUS
}
