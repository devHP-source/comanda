meta {
  name: Update status - kitchen preparing (200)
  type: http
  seq: 20
}

patch {
  url: {{baseUrl}}/orders/{{orderId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{kitchenToken}}
}

body:json {
  {
    "status": "preparing"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq preparing
  res.body.waiter.name: isString
}
