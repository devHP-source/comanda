meta {
  name: Delete dish with image - admin (204)
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}/dishes/{{imageDishId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

assert {
  res.status: eq 204
}

docs {
  Cleans up the test dish and deletes its photo from Cloudinary.
  After this request comanda/dishes has no test photos left.
}
