meta {
  name: Update settings - closedDates duplicate (400)
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "closedDates": ["2027-08-16", "2027-08-16"]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors.closedDates: isString
}
