meta {
  name: Update settings - maxOnlineTables over tableCount (400)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "maxOnlineTables": 60
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors.maxOnlineTables: isString
}
