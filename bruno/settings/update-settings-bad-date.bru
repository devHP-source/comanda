meta {
  name: Update settings - closedDates not a real date (400)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "closedDates": ["2027-08-16", "2027-02-30"]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors.closedDates: isString
}

docs {
  2027-02-30 has the right YYYY-MM-DD shape but doesn't exist. "2027-8-16" (no zero padding) is rejected too.
}
