meta {
  name: Create reservation - no captcha token (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Bot",
    "email": "{{guestEmail}}",
    "phone": "+393331234567",
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 2
  }
}

assert {
  res.status: eq 400
  res.body.code: eq CAPTCHA_FAILED
}

docs {
  A valid booking without turnstileToken: refused before any rule or query, without asking Cloudflare. Runs on local and render. Needs openDate from "Get slots - open day".
}
