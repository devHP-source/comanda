meta {
  name: Get slots - too far ahead (400)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/reservations/slots?date={{farDate}}&partySize=2
  body: none
  auth: none
}

params:query {
  date: {{farDate}}
  partySize: 2
}

assert {
  res.status: eq 400
  res.body.code: eq BOOKING_TOO_FAR
}

script:pre-request {
  const date = new Date()
  date.setUTCDate(date.getUTCDate() + 40) // maxDaysAhead is 30
  bru.setVar("farDate", date.toISOString().slice(0, 10))
}
