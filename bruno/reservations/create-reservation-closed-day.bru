meta {
  name: Create reservation - closed day (400)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Test",
    "email": "{{guestEmail}}",
    "phone": "+393331234567",
    "date": "{{mondayDate}}",
    "time": "20:00",
    "partySize": 2,
    "turnstileToken": "{{turnstileToken}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: the dummy token is refused before this request's own check could run (folder docs)
}

assert {
  res.status: eq 400
  res.body.code: eq RESTAURANT_CLOSED
}

docs {
  Needs mondayDate from "Get slots - closed day".
}
