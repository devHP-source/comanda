meta {
  name: Get slots - party over the limit (400)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/reservations/slots?date={{openDate}}&partySize=201
  body: none
  auth: none
}

params:query {
  date: {{openDate}}
  partySize: 201
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_PARTY_SIZE
}
