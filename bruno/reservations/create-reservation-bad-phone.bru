meta {
  name: Create reservation - phone not E.164 (400)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Test",
    "email": "{{guestEmail}}",
    "phone": "333 1234567",
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 2,
    "turnstileToken": "{{turnstileToken}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: the dummy token is refused before this request's own check could run (folder docs)
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors.phone: isString
}

docs {
  The booking form joins the prefix and the digits before sending. Needs openDate from "Get slots - open day".
}
