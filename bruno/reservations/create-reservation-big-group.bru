meta {
  name: Create reservation - big group (201 pending)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Gruppo",
    "email": "big-group@comanda.test",
    "phone": "+393331234567",
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 11
  }
}

assert {
  res.status: eq 201
  res.body.status: eq pending
  res.body.tablesNeeded: eq 3
}

tests {
  test("a pending booking never expires", () => {
    expect(res.body).to.not.have.property("expiresAt")
  })
}

docs {
  More guests than maxPartySizeAuto: waits for the admin, no verify link. These stay in the database until deleted. Needs openDate from "Get slots - open day".
}
