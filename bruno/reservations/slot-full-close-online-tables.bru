meta {
  name: Slot full - setup, no online tables (200)
  type: http
  seq: 20
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "maxOnlineTables": 0
  }
}

assert {
  res.status: eq 200
  res.body.maxOnlineTables: eq 0
}

docs {
  With no online tables every slot is full, without needing confirmed bookings. "Slot full - restore online tables" puts the default back: always run it after this one. Needs adminToken from "Login - admin".
}
