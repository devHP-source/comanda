meta {
  name: Update status - pending to rejected (200)
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/reservations/{{rejectReservationId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "rejected"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: request 1 can't save bookings with the dummy token (folder docs)
}

assert {
  res.status: eq 200
  res.body.status: eq rejected
  res.body.handledBy.name: isString
  res.body.emailSent: eq true
}
