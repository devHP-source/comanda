meta {
  name: Update status - waiter (403)
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/reservations/{{pendingReservationId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "status": "confirmed"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}
