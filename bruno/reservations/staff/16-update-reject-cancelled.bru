meta {
  name: Update status - cancelled can't be rejected (409)
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/reservations/{{pendingReservationId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "rejected"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: request 1 can't save bookings with the dummy token (folder docs)
}

assert {
  res.status: eq 409
  res.body.code: eq INVALID_RESERVATION_TRANSITION
}
