meta {
  name: Update status - cancelled can't be rejected (409)
  type: http
  seq: 16
}

patch {
  url: {{baseUrl}}/reservations/{{pendingReservationId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "rejected"
  }
}

assert {
  res.status: eq 409
  res.body.code: eq INVALID_RESERVATION_TRANSITION
}
