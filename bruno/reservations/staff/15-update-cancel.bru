meta {
  name: Update status - confirmed to cancelled (200)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/reservations/{{pendingReservationId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "cancelled"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: request 1 can't save bookings with the dummy token (folder docs)
}

assert {
  res.status: eq 200
  res.body.status: eq cancelled
  res.body.handledBy.name: isString
}

docs {
  Also frees the tables held by request 13, so repeated runs don't fill the restaurant.
}
