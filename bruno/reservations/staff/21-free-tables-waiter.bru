meta {
  name: Free tables - waiter (403)
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/reservations/000000000000000000000000/free-tables
  body: none
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}

docs {
  The role is checked before the id, so any id works here (and the request also runs on render).
}
