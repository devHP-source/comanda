meta {
  name: Slot full - restore online tables (200)
  type: http
  seq: 22
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "maxOnlineTables": 36
  }
}

assert {
  res.status: eq 200
  res.body.maxOnlineTables: eq 36
}

docs {
  Puts back what "Slot full - setup" changed. Needs adminToken from "Login - admin".
}
