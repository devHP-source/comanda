meta {
  name: Create reservation - missing fields (400)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 2,
    "turnstileToken": "{{turnstileToken}}"
  }
}

script:pre-request {
  if (bru.getEnvVar("liveCaptcha") === "true") bru.runner.skipRequest() // render: the dummy token is refused before this request's own check could run (folder docs)
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
}

tests {
  test("names every missing field", () => {
    expect(Object.keys(res.body.errors).sort()).to.deep.equal(["email", "name", "phone", "surname"])
  })
}

docs {
  Needs openDate from "Get slots - open day".
}
