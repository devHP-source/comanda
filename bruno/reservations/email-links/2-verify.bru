meta {
  name: 2. Verify - confirmed (200)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/reservations/verify/{{process.env.VERIFY_TOKEN}}
  body: none
  auth: none
}

script:pre-request {
  if (bru.getProcessEnv("RUN_EMAIL_LINKS") !== "true") {
    bru.runner.skipRequest()
  }
}

assert {
  res.status: eq 200
  res.body.status: eq confirmed
}

tests {
  test("a confirmed booking never expires", () => {
    expect(res.body).to.not.have.property("expiresAt")
  })

  test("the tokens are never sent to the client", () => {
    expect(res.body).to.not.have.property("verifyToken")
    expect(res.body).to.not.have.property("cancelToken")
  })
}

docs {
  Sends the confirmation email to EMAIL_LINKS_TO: copy the token at the end of its cancel link into bruno/.env as CANCEL_TOKEN. Skipped unless RUN_EMAIL_LINKS=true (see the folder docs).
}
