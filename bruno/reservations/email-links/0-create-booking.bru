meta {
  name: 0. Create booking - your inbox (201 awaiting_verification)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Link",
    "email": "{{process.env.EMAIL_LINKS_TO}}",
    "phone": "+393331234567",
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 2
  }
}

script:pre-request {
  if (bru.getProcessEnv("RUN_EMAIL_LINKS") !== "true") {
    bru.runner.skipRequest()
  } else {
    // The first Wednesday at least 2 days ahead: open with the default closedDays
    const date = new Date()
    date.setUTCDate(date.getUTCDate() + 2)
    while (date.getUTCDay() !== 3) date.setUTCDate(date.getUTCDate() + 1)
    bru.setVar("openDate", date.toISOString().slice(0, 10))
  }
}

assert {
  res.status: eq 201
  res.body.status: eq awaiting_verification
}

docs {
  Sends the verify email to EMAIL_LINKS_TO: copy the token at the end of its link into bruno/.env as VERIFY_TOKEN (it lasts 30 minutes). Skipped unless RUN_EMAIL_LINKS=true (see the folder docs).
}
