meta {
  name: 8. Verify - after cancelling (404)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/reservations/verify/{{process.env.VERIFY_TOKEN}}
  body: none
  auth: none
}

script:pre-request {
  if (bru.getProcessEnv("RUN_EMAIL_LINKS") !== "true") {
    bru.runner.skipRequest()
  }
}

assert {
  res.status: eq 404
  res.body.code: eq RESERVATION_NOT_FOUND
}

docs {
  The old email link can't bring a cancelled booking back. Skipped unless RUN_EMAIL_LINKS=true (see the folder docs).
}
