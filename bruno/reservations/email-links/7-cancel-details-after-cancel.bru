meta {
  name: 7. Cancel details - after cancelling (200)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/reservations/cancel/{{process.env.CANCEL_TOKEN}}
  body: none
  auth: none
}

script:pre-request {
  if (bru.getProcessEnv("RUN_EMAIL_LINKS") !== "true") {
    bru.runner.skipRequest()
  }
}

assert {
  res.status: eq 200
  res.body.status: eq cancelled
}

docs {
  Reopening the cancel link: the page says "already cancelled" instead of offering the button again. Skipped unless RUN_EMAIL_LINKS=true (see the folder docs).
}
