meta {
  name: Create ticket - waiter, round 1 (201)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "tableNumber": 50,
    "items": [{ "dish": "{{tableDishId}}", "qty": 2 }]
  }
}

assert {
  res.status: eq 201
  res.body.round: eq 1
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("tableOrder1Id", res.body._id)
  }
}
