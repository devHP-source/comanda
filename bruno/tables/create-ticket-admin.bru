meta {
  name: Create ticket - admin, round 2 (201)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "tableNumber": 50,
    "items": [{ "dish": "{{tableDishId}}", "qty": 1 }]
  }
}

assert {
  res.status: eq 201
  res.body.round: eq 2
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("tableOrder2Id", res.body._id)
  }
}
