meta {
  name: Impersonate - from an impersonated token (403)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/impersonate/{{waiterUserId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{impersonatedToken}}
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}

docs {
  The impersonated token belongs to the waiter: authorize("admin") blocks chaining.
}
