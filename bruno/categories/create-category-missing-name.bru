meta {
  name: Create category - missing name.it (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": { "en": "No Italian name" }
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors["name.it"]: isString
}
