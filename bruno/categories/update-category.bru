meta {
  name: Update category - admin (200)
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/categories/{{categoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": { "en": "Test category (edited)" },
    "isCompact": true
  }
}

assert {
  res.status: eq 200
  res.body.name.it: eq Test categoria
  res.body.name.en: eq Test category (edited)
  res.body.isCompact: eq true
}

docs {
  Only the fields sent change: name.it stays. isCompact true --> compact list without photos in the menu (like Bevande).
}
