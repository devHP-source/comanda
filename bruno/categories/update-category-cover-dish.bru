meta {
  name: Update category - cover dish (200)
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/categories/{{seededCategoryId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "coverDish": "{{seededCategoryDishId}}"
  }
}

assert {
  res.status: eq 200
  res.body.coverDish: eq {{seededCategoryDishId}}
}
