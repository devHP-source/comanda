meta {
  name: Get categories
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/categories
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].coverImage: isString
  res.body[0].isCompact: isBoolean
}

docs {
  coverImage = photo of coverDish, else the first published dish of the category with a photo, else "" (placeholder).
  isCompact = true only for categories shown as a compact list without photos (Bevande).
}

script:post-response {
  // First category in menu order (Antipasti): it has dishes, used by "Delete category - with dishes"
  if (res.status === 200 && res.body.length) {
    bru.setVar("seededCategoryId", res.body[0]._id)
  }
}
