meta {
  name: Get dishes (full menu)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/dishes
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body: isArray
}

tests {
  test("dishes sorted by code with numeric ordering (1, 1a, ...)", function () {
    expect(res.body[1].code).to.equal("1a");
  });
}
