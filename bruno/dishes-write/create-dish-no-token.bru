meta {
  name: Create dish - no token (401)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/dishes
  body: json
  auth: none
}

body:json {
  {
    "code": "TEST1",
    "name": { "it": "Piatto di prova" },
    "price": 8.5,
    "category": "{{seededCategoryId}}"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq NO_TOKEN
}
