meta {
  name: Create dish - unknown category (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/dishes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "code": "TEST1",
    "name": { "it": "Piatto di prova" },
    "price": 8.5,
    "category": "000000000000000000000000"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_CATEGORY
}
