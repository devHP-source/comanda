meta {
  name: Create dish - missing fields, price not a number (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/dishes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": { "en": "No Italian name" },
    "price": "abc"
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
  res.body.errors.code: isString
  res.body.errors["name.it"]: isString
  res.body.errors.price: isString
  res.body.errors.category: isString
}
