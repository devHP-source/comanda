meta {
  name: Create dish - waiter (403)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/dishes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "code": "TEST1",
    "name": { "it": "Piatto di prova" },
    "price": 8.5,
    "category": "{{seededCategoryId}}"
  }
}

assert {
  res.status: eq 403
  res.body.code: eq FORBIDDEN
}
