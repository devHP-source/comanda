meta {
  name: Order - table number operator (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "tableNumber": {
      "$gt": 0
    },
    "items": [
      {
        "dish": "000000000000000000000000",
        "qty": 1
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_TABLE
}
