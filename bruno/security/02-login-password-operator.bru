meta {
  name: Login - password operator (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{process.env.SEED_ADMIN_EMAIL}}",
    "password": {
      "$ne": null
    }
  }
}

assert {
  res.status: eq 400
  res.body.code: eq MISSING_CREDENTIALS
}
