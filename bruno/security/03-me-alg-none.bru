meta {
  name: Me - unsigned alg none token (401)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJpZCI6IjAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMCIsImtpbmQiOiJzdGFmZiIsInJvbGUiOiJhZG1pbiJ9.
}

assert {
  res.status: eq 401
  res.body.code: eq INVALID_TOKEN
}

docs {
  A token with "alg": "none" and no signature, claiming to be an admin: only HS256 is accepted.
}
