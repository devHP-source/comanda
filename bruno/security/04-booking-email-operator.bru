meta {
  name: Booking - email operator (400)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Sicurezza",
    "email": {
      "$ne": null
    },
    "phone": "+393331234567",
    "date": "{{openDate}}",
    "time": "20:00",
    "partySize": 2,
    "turnstileToken": "{{turnstileToken}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("answers VALIDATION_FAILED", () => {
    const expected = bru.getEnvVar("liveCaptcha") === "true" ? "CAPTCHA_FAILED" : "VALIDATION_FAILED" // render: Turnstile answers first (folder docs)
    expect(res.body.code).to.equal(expected)
  })
}
