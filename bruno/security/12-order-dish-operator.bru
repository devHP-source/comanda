meta {
  name: Order - dish id operator (400)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "tableNumber": 1,
    "items": [
      {
        "dish": {
          "$ne": null
        },
        "qty": 1
      }
    ]
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_ID
}
