meta {
  name: Availability - operator (400)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/dishes/000000000000000000000000/availability
  body: json
  auth: bearer
}

auth:bearer {
  token: {{waiterToken}}
}

body:json {
  {
    "isAvailable": {
      "$ne": null
    }
  }
}

assert {
  res.status: eq 400
  res.body.code: eq INVALID_AVAILABILITY
}
