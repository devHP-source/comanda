meta {
  name: Settings - number operator (400)
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "tableCount": {
      "$gt": 0
    }
  }
}

assert {
  res.status: eq 400
  res.body.code: eq VALIDATION_FAILED
}
