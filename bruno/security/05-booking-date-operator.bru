meta {
  name: Booking - date operator (400)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/reservations
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno",
    "surname": "Sicurezza",
    "email": "security@comanda.test",
    "phone": "+393331234567",
    "date": {
      "$gte": ""
    },
    "time": "20:00",
    "partySize": 2,
    "turnstileToken": "{{turnstileToken}}"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("answers INVALID_DATE", () => {
    const expected = bru.getEnvVar("liveCaptcha") === "true" ? "CAPTCHA_FAILED" : "INVALID_DATE" // render: Turnstile answers first (folder docs)
    expect(res.body.code).to.equal(expected)
  })
}
