meta {
  name: Login - wrong password (401)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{process.env.SEED_ADMIN_EMAIL}}",
    "password": "definitely-not-the-password"
  }
}

assert {
  res.status: eq 401
  res.body.code: eq INVALID_CREDENTIALS
}
